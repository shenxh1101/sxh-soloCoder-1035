{
  "name": "ecommerce-ops-client",
  "version": "1.0.0",
  "description": "电商运营桌面客户端 - 多店铺商品与活动管理工具",
  "main": "dist-electron/main/index.js",
  "author": "Ecommerce Ops Team",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "build:only": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && tsc -p tsconfig.electron.json && electron .\"",
    "electron:build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json && electron-builder"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "element-plus": "^2.4.4",
    "@element-plus/icons-vue": "^2.3.1",
    "dayjs": "^1.11.10",
    "xlsx": "^0.18.5",
    "papaparse": "^5.4.1",
    "lowdb": "^7.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.8",
    "vite-plugin-electron": "^0.15.5",
    "vite-plugin-electron-renderer": "^0.14.5",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vue-tsc": "^1.8.27",
    "@types/node": "^20.10.5",
    "@types/papaparse": "^5.3.14",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "sass": "^1.69.5"
  },
  "build": {
    "appId": "com.ecommerce.ops.client",
    "productName": "电商运营助手",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
